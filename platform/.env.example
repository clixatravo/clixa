# SOC-06 — Variables d'environnement.
#
# Copier en .env.local pour le développement. Ne jamais commiter .env.local :
# il est déjà couvert par .gitignore.
#
# Chaque variable est optionnelle : l'application démarre sans aucune d'elles.
# C'est volontaire — le front public n'a besoin de rien pour fonctionner.

# ── Site ────────────────────────────────────────────────────────────────────
# Base des URL absolues : canoniques, Open Graph, sitemap.
# Sans elle, la valeur de repli est https://clixa-institute.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mettre "production" UNIQUEMENT sur le site réellement public.
# Toute autre valeur (ou l'absence de valeur) désindexe entièrement le site :
# une préversion ne doit jamais apparaître dans Google avec des tarifs de
# démonstration associés aux coordonnées réelles de CLIXA.
NEXT_PUBLIC_SITE_ENV=preview

# ── Observabilité (SOC-07) ──────────────────────────────────────────────────
# Laisser vide désactive proprement l'outil. À renseigner une fois les comptes
# créés — ces deux clés sont publiques par conception, elles vont au navigateur.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# ── Phase 02 — ne pas renseigner avant le tunnel de paiement ───────────────
# STRIPE_SECRET_KEY=
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# WHATSAPP_TOKEN=

# ── Courriels (phase 02) ───────────────────────────────────────────────────
# Sans clé, Payload écrit les messages dans la console au lieu de les envoyer :
# le tunnel d'inscription tourne alors sans qu'aucun courriel ne parte.
RESEND_API_KEY=
# L'expéditeur doit appartenir à un domaine vérifié chez Resend. À défaut,
# Resend n'accepte que onboarding@resend.dev.
EMAIL_EXPEDITEUR=
# Où arrivent les notifications internes. Vide : personne n'est prévenu.
EMAIL_EQUIPE=
# Protège /api/relances, que le planificateur de Vercel appelle chaque matin.
# Vide : la route est ouverte à qui connaît son adresse.
CRON_SECRET=
# GOOGLE_CALENDAR_CREDENTIALS=

# ── Phase 01 temps 3 — Payload / base de données ───────────────────────────
# DATABASE_URL=
# PAYLOAD_SECRET=
